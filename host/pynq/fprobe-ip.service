# /etc/systemd/system/fprobe-ip.service
# eth0 を固定のアドレス <家の LAN のアドレス>/24 にする（host/pynq/fprobe-ip）。DHCP の IP が起動のたびに変わるため。
[Unit]
Description=fprobe: fixed address <家の LAN のアドレス> on eth0
After=network-online.target ifup@eth0.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/fprobe-ip

[Install]
WantedBy=multi-user.target
