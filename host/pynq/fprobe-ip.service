# /etc/systemd/system/fprobe-ip.service
# eth0 を固定のアドレス 192.168.0.2/24 にする（host/pynq/fprobe-ip）。DHCP の IP が起動のたびに変わるため。
[Unit]
Description=fprobe: fixed address 192.168.0.2 on eth0
After=network-online.target ifup@eth0.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/fprobe-ip

[Install]
WantedBy=multi-user.target
