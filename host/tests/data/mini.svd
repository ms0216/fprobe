<?xml version="1.0" encoding="utf-8"?>
<!-- fprobe.svd の試験用の手書きの SVD。SVD 1.3 の形（継承・derivedFrom・dim・クラスタ・列挙・bitRange・lsb/msb・
     readAction）を 1 つずつ入れる。番地・値は架空。 -->
<device schemaVersion="1.3">
  <name>MINI1</name>
  <description>Tiny test device</description>
  <cpu><name>CM4</name><revision>r0p1</revision><endian>little</endian></cpu>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <peripherals>
    <peripheral>
      <name>TIMER0</name>
      <description>Timer</description>
      <groupName>TIMER</groupName>
      <baseAddress>0x40001000</baseAddress>
      <addressBlock><offset>0</offset><size>0x400</size><usage>registers</usage></addressBlock>
      <registers>
        <register>
          <name>CTRL</name>
          <description>Control</description>
          <addressOffset>0x00</addressOffset>
          <resetValue>0x00000004</resetValue>
          <fields>
            <field>
              <name>EN</name>
              <description>Enable</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <name>OnOff</name>
                <enumeratedValue><name>Off</name><value>0</value></enumeratedValue>
                <enumeratedValue><name>On</name><value>1</value></enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MODE</name>
              <bitRange>[3:1]</bitRange>
              <enumeratedValues>
                <usage>read-write</usage>
                <enumeratedValue><name>OneShot</name><description>Stop at the end</description><value>0</value></enumeratedValue>
                <enumeratedValue><name>Periodic</name><value>0x2</value></enumeratedValue>
                <enumeratedValue><name>Capture</name><value>#1x0</value></enumeratedValue>
                <enumeratedValue><name>Reserved</name><isDefault>true</isDefault></enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PRESCALE</name>
              <lsb>8</lsb>
              <msb>15</msb>
            </field>
            <field>
              <name>START</name>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <register derivedFrom="CTRL">
          <name>CTRL2</name>
          <addressOffset>0x04</addressOffset>
        </register>
        <register>
          <name>STATUS</name>
          <addressOffset>0x08</addressOffset>
          <access>read-only</access>
          <fields>
            <field><name>DONE</name><bitOffset>0</bitOffset><bitWidth>1</bitWidth>
              <enumeratedValues derivedFrom="OnOff"/>
            </field>
            <field><name>COUNT</name><bitRange>[23:8]</bitRange></field>
          </fields>
        </register>
        <register>
          <name>DATA</name>
          <addressOffset>0x0C</addressOffset>
          <readAction>clear</readAction>
        </register>
        <register>
          <dim>4</dim>
          <dimIncrement>4</dimIncrement>
          <name>CH[%s]</name>
          <addressOffset>0x10</addressOffset>
          <resetValue>0xFFFF0000</resetValue>
          <fields>
            <field><name>VALUE</name><bitOffset>0</bitOffset><bitWidth>16</bitWidth></field>
          </fields>
        </register>
        <register>
          <dim>3</dim>
          <dimIncrement>2</dimIncrement>
          <dimIndex>A,B,C</dimIndex>
          <name>PIN%s_CFG</name>
          <addressOffset>0x20</addressOffset>
          <size>16</size>
          <fields>
            <field>
              <dim>2</dim>
              <dimIncrement>4</dimIncrement>
              <name>SEL%s</name>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <cluster>
          <dim>2</dim>
          <dimIncrement>0x10</dimIncrement>
          <name>BUF[%s]</name>
          <addressOffset>0x40</addressOffset>
          <register><name>ADDR</name><addressOffset>0x0</addressOffset></register>
          <register><name>LEN</name><addressOffset>0x4</addressOffset><size>16</size><resetValue>0x0010</resetValue></register>
        </cluster>
        <register>
          <name>ALT_IN</name>
          <addressOffset>0x60</addressOffset>
        </register>
        <register>
          <name>ALT_OUT</name>
          <alternateRegister>ALT_IN</alternateRegister>
          <addressOffset>0x60</addressOffset>
        </register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="TIMER0">
      <name>TIMER1</name>
      <baseAddress>0x40002000</baseAddress>
    </peripheral>
    <peripheral>
      <name>UART</name>
      <baseAddress>0x40003000</baseAddress>
      <size>16</size>
      <addressBlock><offset>0</offset><size>0x100</size><usage>registers</usage></addressBlock>
      <registers>
        <register>
          <name>DR</name>
          <addressOffset>0</addressOffset>
          <fields><field><name>DATA</name><bitOffset>0</bitOffset><bitWidth>8</bitWidth><readAction>modify</readAction></field></fields>
        </register>
        <register derivedFrom="TIMER0.STATUS">
          <name>SR</name>
          <addressOffset>4</addressOffset>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>
